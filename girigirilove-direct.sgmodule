#!name=指定域名直连合集
#!desc=整合 Girigirilove、Cloudflare 地区检测和用户提供的指定域名直连规则
#!category=网络访问

[Rule]

# > 无尽冬日核心服务直连（合并自附件）
DOMAIN-SUFFIX,campfiregames.cn,DIRECT
DOMAIN-SUFFIX,centurygame.com,DIRECT
DOMAIN-SUFFIX,centurygames.com,DIRECT
DOMAIN-SUFFIX,dailygn.com,DIRECT
DOMAIN,ir-sdk.dun.163.com,DIRECT

# > 用户提供的指定直连规则
DOMAIN-KEYWORD,xfmanga,DIRECT
DOMAIN-SUFFIX,play.xfvod.pro,DIRECT
DOMAIN-KEYWORD,moonci,DIRECT
DOMAIN-KEYWORD,quark,DIRECT
DOMAIN-KEYWORD,cycstream,DIRECT
DOMAIN-KEYWORD,cycani,DIRECT

# > Cloudflare 地区检测
# 仅让 ani 页面调用的地区探测请求直连，避免代理出口地区触发站方跳转
DOMAIN,cloudflare.com,DIRECT

# > Girigirilove 页面加载依赖
DOMAIN-SUFFIX,polyfill-js.cn,DIRECT
DOMAIN-SUFFIX,f.clarity.ms,DIRECT

# > 用户提供的指定直连域名
DOMAIN-SUFFIX,acc.skyysw.com,DIRECT
DOMAIN-SUFFIX,vip1.lz-cdn6.com,DIRECT
DOMAIN-SUFFIX,v16m-default.akamaized.net,DIRECT
DOMAIN-SUFFIX,www.emw5es6.com,DIRECT
DOMAIN-SUFFIX,api.xkpcth.com,DIRECT
DOMAIN-SUFFIX,doh.pub,DIRECT
DOMAIN-SUFFIX,api.gq89em.com,DIRECT
DOMAIN-SUFFIX,resource.nj82wbp.top,DIRECT
DOMAIN-SUFFIX,go.mayzaent.com,DIRECT
DOMAIN-SUFFIX,yzzy.play-cdn10.com,DIRECT
DOMAIN-SUFFIX,cos.hxx2023.cc,DIRECT
DOMAIN-SUFFIX,qsvip.hxx2023.cc,DIRECT
DOMAIN-SUFFIX,cdn4.rplay4.com,DIRECT

# 日志分析确认的播放器和统计域名直连候选
DOMAIN,analytics.adjust.io,DIRECT
DOMAIN,union.dplayerstatic.com,DIRECT

# 日志中视频站资源和接口的直连候选
