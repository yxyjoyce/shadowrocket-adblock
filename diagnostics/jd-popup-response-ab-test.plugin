#!name = JD queryPagePopWindow 接口 A/B 临时测试（可撤销）
#!desc = 临时测试：精确拦截 queryPagePopWindow 接口，并按 Image_JDAppHome 与素材文件名前缀经验性拒绝 m15 首页图片；可能误伤或漏拦其他素材，共享域名 MITM 可能变慢，尚未证实对应截图浮窗；关闭本插件即可撤销
#!type = normal
#!loon_version = 3.5.1(983)

[Rewrite]
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=queryPagePopWindow(?:&[^&]*)*$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/m15\.360buyimg\.com\/mobilecms\/jfs\/t1\/535295\/1\/15284\/16310\/6ad76d7aF40ccb489\/02581b013ea1b837\.png\.webp(?:\?.*)?$/ then reject_img(200)
request if ${url} ~= /^https:\/\/m15\.360buyimg\.com\/mobilecms\/jfs\/t1\/542232\/20\/10106\/20235\/6ad81abdF82ec8b07\/02761b013ebec24e\.png\.webp(?:\?.*)?$/ then reject_img(200)
request if ${url} ~= /^https:\/\/m15\.360buyimg\.com\/mobilecms\/jfs\/t1\/562263\/29\/1650\/19727\/6ae1d763Fa468ff12\/02761b013e4d11bd\.png\.webp(?:\?.*)?$/ then reject_img(200)
request if ${url} ~= /^https:\/\/m15\.360buyimg\.com\/mobilecms\/jfs\/t1\/548794\/19\/11257\/17129\/6ae1d776F099b7917\/02761b013ef71270\.png\.webp(?:\?.*)?$/ then reject_img(200)
request if ${url} ~= /^https:\/\/m15\.360buyimg\.com\/mobilecms\/jfs\/t1\/[^?]*\/(?:02761b013|00ae1b013)[^\/?]*\.png\.webp(?:\?.*)?$/ && ${request.header['referer']} == "Image_JDAppHome" then reject_img(200)

[Mitm]
hostname = api.m.jd.com, m15.360buyimg.com
