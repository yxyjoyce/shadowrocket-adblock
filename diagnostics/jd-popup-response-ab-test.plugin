#!name = JD queryPagePopWindow 接口 A/B 临时测试（可撤销）
#!desc = 临时测试：精确拦截 queryPagePopWindow 接口，并直接拒绝整个 m15.360buyimg.com 域名；商品图片与首页内容可能缺失或加载减速，尚未证实对应截图浮窗；关闭旧图片测试插件；关闭本插件即可撤销
#!type = normal
#!loon_version = 3.5.1(983)

[Rule]
DOMAIN,m15.360buyimg.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=queryPagePopWindow(?:&[^&]*)*$/ then reject_dict(200)

[Mitm]
hostname = api.m.jd.com
