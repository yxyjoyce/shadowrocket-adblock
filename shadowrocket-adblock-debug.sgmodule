^https?:\/\/static\.catlinks\.cn\/image\/exchange20260807\.jpg.* - reject-200

[Body Rewrite]
# QX jsonjq-response-body 的 Shadowrocket 原生等价写法；仅这两条会修改响应 JSON。
http-response-jq ^https?:\/\/api\.wtzw\.com\/api\/free\/dd(?:\?.*)?$ '.data.ad={}'
http-response-jq ^https?:\/\/api\.qeeniao\.com\/nap\/ad '.data={}'

[Script]
# 两条脚本均 requires-body、无限 body 上限、30 秒超时；只记录并原样返回，不修改响应。
xiaocan_debug = type=http-response, pattern=^https?:\/\/gw\.xiaocantech\.com\/rpc(?:\?.*)?$, script-path=https://raw.githubusercontent.com/yxyjoyce/shadowrocket-adblock/main/xiaocan-matchplacement-shadowrocket-debug.js, requires-body=true, max-size=-1, timeout=30, engine=jsc
qimao_debug = type=http-response, pattern=^https?:\/\/cgcr\.wtzw\.com\/client\/api\/v1\/config(?:\?.*)?$, script-path=https://raw.githubusercontent.com/yxyjoyce/shadowrocket-adblock/main/qimao-qm-focus-shadowrocket-debug.js, requires-body=true, max-size=-1, timeout=30, engine=jsc

[MITM]
# 必须使用 %APPEND%，并保留独立 QX rewrite 资源的完整 hostname 清单。
hostname = %APPEND% ad.baihemob.com, inner.baihemob.com, gw.xiaocantech.com, p6sops-cn.p6sai.com, api.wtzw.com, api-cfg.wtzw.com, api-bc.wtzw.com, api-gw.wtzw.com, cgcr.wtzw.com, a6-remad.qm989.com, cdn-new-ad.wtzw.com, vdn-ad.vzuu.com, nexorax.datads.cn, p11-sign.douyinpic.com, lf-cdn-tos.bytescm.com, ads-bid.leadmoad.com, ad-api.adn-plus.com.cn, adprolink.xwpbj.com, de.ad.gameley.com, sdkapi.richmob.cn, adsdk.richmob.cn, sdkconf.adbiding.com, bid.adbiding.com, cn-acs.m.cainiao.com, guoguo-cdn.cainiao.com, netflow-mtop.cainiao.com, umestartup.umetrip.com, discardrp.umetrip.com, startup.umetrip.com, appmsg.umetrip.com, sns.umetrip.com, oss.umetrip.com, a.cpic.com.cn, tklife.mobile.taikang.com, m.ctrip.com, ma-adx.ctrip.com, app-sh.catlinks.cn, static.catlinks.cn, api.qeeniao.com
