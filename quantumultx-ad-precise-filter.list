# Quantumult X 去广告精确补充分流资源
# 用法：添加到 [filter_remote]；抖音业务图片 direct 例外需先于泛拒绝资源生效。

# 睿博士（P6SLite）：抓包确认返回广告创意、落地页和监测；不包含 p6sai 业务接口
host, ad.shunchangzhixing.com, reject
host, inner.shunchangzhixing.com, reject
host, admin.hzjizhun.cn, reject
host, static.shunchangzhixing.com, reject

# 睿博士：本次抓包确认的广告 SDK 投放端点
host, sdk.1rtb.net, reject
host, s.1rtb.net, reject
host, sdk.zhangyuyidong.cn, reject
host, adx-cfg-u1.ubixioe.com, reject
host, entry-su1.ubixioe.com, reject

# 七猫：HAR 确认的章节中段/底部广告素材与广告投放引擎
host, cdn-new-ad.wtzw.com, reject
host, a6-remad.qm989.com, reject

# 七猫：新 HAR 确认的内嵌 Pangle 直播广告配置、素材与 CDN 回源
host, webcast-open.douyin.com, reject
host, webcast5-open-lf.douyin.com, reject
host, is.snssdk.com, reject
host, gecko.zijieapi.com, reject
host, vod-license-m.volccdn.com, reject
host, lf9-webcast-cdn-tos-ncdn.bytegecko.com, reject
host, n98-lf-webcast-cdn-tos-ncdn.bytegecko.com, reject
host, p3-sign.douyinpic.com, reject
host, p26-sign.douyinpic.com, reject
host-suffix, bjmxy.net, reject
host-suffix, ydycdn.com, reject
host-suffix, dahhxxttxs.com, reject

# 红果：日志确认的下一集广告域名
host, adx-ad-prod.wkanx.com, reject

# 抖音：业务图片例外；必须位于任何字节/抖音图片泛拒绝规则之前
